      "stepNumber": 1,
      "title": "Separate Variables",
      "mathExpression": "\\frac{1}{y^2} dy = 2x \\, dx",
      "explanation": "Group y-terms on the left and x-terms on the right.",
      "why": "Separation of variables technique."
    },
