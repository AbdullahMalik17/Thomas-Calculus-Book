      "stepNumber": 1,
      "title": "Recall Derivative of tanh",
      "mathExpression": "\\frac{d}{dx}[\\tanh(u)] = \\text{sech}^2(u) \\cdot u'",
      "explanation": "Hyperbolic tangent derivative rule.",
      "why": "Chain Rule."
