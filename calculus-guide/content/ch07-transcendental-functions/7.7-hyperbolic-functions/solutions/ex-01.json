      "stepNumber": 2,
      "title": "Differentiate Argument 4x",
      "mathExpression": "u = 4x \\implies u' = 4 \\implies \\frac{dy}{dx} = 4 \\text{sech}^2(4x)",
      "explanation": "Multiply by 4.",
      "why": "Final evaluated derivative."
