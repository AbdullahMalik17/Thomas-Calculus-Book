      "stepNumber": 3,
      "title": "Conclude Remainder Bounds",
      "mathExpression": "\\frac{1}{2(n+1)^2} \\le R_n \\le \\frac{1}{2n^2}",
      "explanation": "Substitute k = n+1 and k = n.",
      "why": "Exact error bounds."
    }
