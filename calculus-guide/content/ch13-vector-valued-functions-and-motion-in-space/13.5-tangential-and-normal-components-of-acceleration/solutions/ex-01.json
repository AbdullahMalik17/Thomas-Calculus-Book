  "title": "Decomposition of Acceleration for a Space Curve",
  "exerciseReference": "Section 13.5, Exercise 1",
  "originalTopic": "Acceleration Components",
  "difficulty": "tier2",
  "status": "verified",
  "tags": [
    "tangential-acceleration",
