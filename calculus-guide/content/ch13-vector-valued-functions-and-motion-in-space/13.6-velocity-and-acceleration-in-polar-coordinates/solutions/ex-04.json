  "problemStatement": "Compute the rate at which area is swept out by a planet at r = 10 AU with angular velocity d(theta)/dt = 0.4 rad/year.",
  "finalAnswer": "\\frac{dA}{dt} = 20 \\text{ AU}^2/\\text{year}",
  "steps": [
