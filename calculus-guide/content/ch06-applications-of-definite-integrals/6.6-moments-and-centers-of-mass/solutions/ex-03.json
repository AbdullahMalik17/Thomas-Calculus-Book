  "problemStatement": "Find the centroid of the triangle bounded by y = 2x, y = 0, and x = 3.",
  "finalAnswer": "(\\bar{x}, \\bar{y}) = (2, 2)",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Calculate Triangle Area",
      "mathExpression": "A = \\frac{1}{2} \\cdot \\text{Base} \\cdot \\text{Height} = \\frac{1}{2} (3)(6) = 9",
      "explanation": "Base is 3, height is f(3) = 6.",
      "why": "Geometric area."
    },
    {
      "stepNumber": 2,
      "title": "Compute x-bar via Integration",
      "mathExpression": "\\bar{x} = \\frac{1}{A} \\int_0^3 x(2x) dx = \\frac{1}{9} \\left[ \\frac{2x^3}{3} \\right]_0^3 = \\frac{1}{9} (18) = 2",
      "explanation": "Centroid lies at 2/3 of distance from vertex.",
      "why": "Moment about y-axis."
    },
    {
      "stepNumber": 3,
      "title": "Compute y-bar via Integration",
      "mathExpression": "\\bar{y} = \\frac{1}{A} \\int_0^3 \\frac{1}{2}(2x)^2 dx = \\frac{1}{9} \\int_0^3 2x^2 dx = \\frac{1}{9} \\left[ \\frac{2x^3}{3} \\right]_0^3 = \\frac{1}{9}(18) = 2",
      "explanation": "Centroid of a right triangle is at (b/3, h/3) from right angle (3 - 1, 0 + 2) = (2, 2).",
      "why": "Moment about x-axis."
    }
  ],
