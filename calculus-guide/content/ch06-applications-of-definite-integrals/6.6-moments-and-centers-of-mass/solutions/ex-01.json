  "problemStatement": "Find the center of mass of three particles with masses m_1 = 2 kg, m_2 = 3 kg, and m_3 = 5 kg located at points (1, 2), (-2, 4), and (3, -1) respectively.",
  "finalAnswer": "(\\bar{x}, \\bar{y}) = \\left( \\frac{11}{10}, \\frac{11}{10} \\right) = (1.1, 1.1)",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Compute Total Mass M",
      "mathExpression": "M = m_1 + m_2 + m_3 = 2 + 3 + 5 = 10 \\text{ kg}",
      "explanation": "Sum individual point masses.",
      "why": "Total system mass."
    },
    {
      "stepNumber": 2,
      "title": "Calculate Moments M_y and M_x",
      "mathExpression": "M_y = \\sum m_i x_i = 2(1) + 3(-2) + 5(3) = 2 - 6 + 15 = 11; \\quad M_x = \\sum m_i y_i = 2(2) + 3(4) + 5(-1) = 4 + 12 - 5 = 11",
      "explanation": "Multiply each mass by its coordinate.",
      "why": "First moment definitions."
    },
    {
      "stepNumber": 3,
      "title": "Compute Coordinates (x_bar, y_bar)",
      "mathExpression": "\\bar{x} = \\frac{M_y}{M} = \\frac{11}{10} = 1.1, \\quad \\bar{y} = \\frac{M_x}{M} = \\frac{11}{10} = 1.1",
      "explanation": "Divide moments by total mass.",
      "why": "Center of mass coordinates."
    }
  ],
