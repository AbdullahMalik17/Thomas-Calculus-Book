  "author": "Muhammad Abdullah Athar",
  "problemStatement": "Find the surface area generated by revolving the circle arc y = sqrt(R^2 - x^2) for a <= x <= b about the x-axis.",
  "finalAnswer": "S = 2\\pi R (b - a)",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Compute Derivative and ds",
      "mathExpression": "y' = -\\frac{x}{\\sqrt{R^2 - x^2}} \\implies 1 + (y')^2 = 1 + \\frac{x^2}{R^2 - x^2} = \\frac{R^2}{R^2 - x^2}",
      "explanation": "Combine terms over common denominator.",
      "why": "Circle arc differential."
    },
    {
      "stepNumber": 2,
      "title": "Take Square Root to Find ds",
      "mathExpression": "ds = \\frac{R}{\\sqrt{R^2 - x^2}} dx",
      "explanation": "Simplify the radical.",
      "why": "ds element."
    },
    {
      "stepNumber": 3,
      "title": "Integrate 2 pi y ds",
      "mathExpression": "S = 2\\pi \\int_a^b \\sqrt{R^2 - x^2} \\cdot \\frac{R}{\\sqrt{R^2 - x^2}} dx = 2\\pi R \\int_a^b 1 \\, dx = 2\\pi R (b - a)",
      "explanation": "The radical factor completely cancels out.",
      "why": "Archimedes' theorem on spherical zones."
    }
  ],
  "sympyVerification": {
    "operation": "algebraic_equivalence",
    "expression": "2*pi*R*(b - a) - 2*pi*R*(b - a)",
    "expected": "0"
  }
}