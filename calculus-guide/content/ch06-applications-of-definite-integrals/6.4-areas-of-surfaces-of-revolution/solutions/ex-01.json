  "author": "Muhammad Abdullah Athar",
  "problemStatement": "Find the area of the surface generated by revolving y = 2 sqrt(x) on [0, 3] about the x-axis.",
  "finalAnswer": "S = \\frac{8\\pi}{3}(8 - 1) = \\frac{56\\pi}{3}",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Compute y' and Arc Length Element ds",
      "mathExpression": "y' = \\frac{1}{\\sqrt{x}} \\implies ds = \\sqrt{1 + \\frac{1}{x}} \\, dx = \\sqrt{\\frac{x + 1}{x}} \\, dx = \\frac{\\sqrt{x + 1}}{\\sqrt{x}} dx",
      "explanation": "Find derivative and express common denominator inside radical.",
      "why": "Constructing ds."
    },
    {
      "stepNumber": 2,
      "title": "Multiply by 2 pi y",
      "mathExpression": "2\\pi y \\, ds = 2\\pi (2\\sqrt{x}) \\frac{\\sqrt{x + 1}}{\\sqrt{x}} dx = 4\\pi \\sqrt{x + 1} \\, dx",
      "explanation": "The factor sqrt(x) in the denominator cancels with sqrt(x) in y.",
      "why": "Algebraic cancellation simplifies the integrand."
    },
    {
      "stepNumber": 3,
      "title": "Integrate over [0, 3]",
      "mathExpression": "S = 4\\pi \\int_0^3 (x + 1)^{1/2} dx = 4\\pi \\left[ \\frac{2}{3}(x + 1)^{3/2} \\right]_0^3 = \\frac{8\\pi}{3}(4^{3/2} - 1^{3/2}) = \\frac{8\\pi}{3}(8 - 1) = \\frac{56\\pi}{3}",
      "explanation": "Evaluate the power integral.",
      "why": "Final exact surface area."
    }
  ],
