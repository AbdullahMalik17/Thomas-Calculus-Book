  "author": "Muhammad Abdullah Athar",
  "problemStatement": "Find the surface area generated by revolving y = x^3 on [0, 1] about the x-axis.",
  "finalAnswer": "S = \\frac{\\pi}{27}(10\\sqrt{10} - 1)",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Calculate y' and ds",
      "mathExpression": "y' = 3x^2 \\implies ds = \\sqrt{1 + 9x^4} \\, dx",
      "explanation": "Square the derivative.",
      "why": "Arc length element."
    },
    {
      "stepNumber": 2,
      "title": "Set Up Surface Area Integral",
      "mathExpression": "S = 2\\pi \\int_0^1 x^3 \\sqrt{1 + 9x^4} \\, dx",
      "explanation": "Integrate 2pi * y * ds.",
      "why": "Surface area formula."
    },
    {
      "stepNumber": 3,
      "title": "Substitute u = 1 + 9x^4",
      "mathExpression": "u = 1 + 9x^4 \\implies du = 36x^3 dx; \\quad S = \\frac{2\\pi}{36} \\int_1^{10} u^{1/2} du = \\frac{\\pi}{18} \\left[ \\frac{2}{3} u^{3/2} \\right]_1^{10} = \\frac{\\pi}{27}(10^{3/2} - 1) = \\frac{\\pi}{27}(10\\sqrt{10} - 1)",
      "explanation": "Evaluate the transformed definite integral.",
      "why": "Final exact value."
    }
  ],
