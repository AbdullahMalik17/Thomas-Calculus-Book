  "author": "Muhammad Abdullah Athar",
  "problemStatement": "Find the volume of the solid generated by revolving the region under y = 3x - x^2 on [0, 3] about the y-axis.",
  "finalAnswer": "V = \\frac{27\\pi}{2}",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Identify Shell Radius and Shell Height",
      "mathExpression": "r(x) = x, \\quad h(x) = 3x - x^2 \\quad \\text{for } x \\in [0, 3]",
      "explanation": "Radius is the distance from y-axis; height is the function value.",
      "why": "Shell method definitions."
    },
    {
      "stepNumber": 2,
      "title": "Set Up Shell Integral",
      "mathExpression": "V = 2\\pi \\int_0^3 x(3x - x^2) dx = 2\\pi \\int_0^3 (3x^2 - x^3) dx",
      "explanation": "Multiply radius by height and factor out 2pi.",
      "why": "2pi * radius * height * dx."
    },
    {
      "stepNumber": 3,
      "title": "Evaluate Definite Integral",
      "mathExpression": "2\\pi \\left[ x^3 - \\frac{x^4}{4} \\right]_0^3 = 2\\pi \\left( 27 - \\frac{81}{4} \\right) = 2\\pi \\left( \\frac{27}{4} \\right) = \\frac{27\\pi}{2}",
      "explanation": "Compute antiderivative at boundaries.",
      "why": "Final exact volume."
    }
  ],
