  "author": "Muhammad Abdullah Athar",
  "problemStatement": "Find the volume generated by revolving the region under y = x^2 on [0, 2] about the vertical line x = -1.",
  "finalAnswer": "V = \\frac{56\\pi}{3}",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Determine Shifted Shell Radius",
      "mathExpression": "r(x) = x - (-1) = x + 1, \\quad h(x) = x^2 \\quad \\text{for } x \\in [0, 2]",
      "explanation": "Distance from x to line x = -1 is x + 1.",
      "why": "Radius relative to shifted axis."
    },
    {
      "stepNumber": 2,
      "title": "Expand Integrand",
      "mathExpression": "r(x) h(x) = (x + 1)x^2 = x^3 + x^2",
      "explanation": "Multiply radius by height.",
      "why": "Shell integrand construction."
    },
    {
      "stepNumber": 3,
      "title": "Evaluate Volume",
      "mathExpression": "V = 2\\pi \\int_0^2 (x^3 + x^2) dx = 2\\pi \\left[ \\frac{x^4}{4} + \\frac{x^3}{3} \\right]_0^2 = 2\\pi \\left( 4 + \\frac{8}{3} \\right) = 2\\pi \\left( \\frac{20}{3} \\right) = \\frac{40\\pi}{3}",
      "explanation": "Evaluate the definite integral.",
      "why": "Final exact volume."
    }
  ],
