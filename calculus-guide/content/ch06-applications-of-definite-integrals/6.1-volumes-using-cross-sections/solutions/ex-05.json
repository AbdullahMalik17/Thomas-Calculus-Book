  ],
  "author": "Muhammad Abdullah Athar",
  "problemStatement": "Find the volume generated by revolving the region bounded by y = x^3, y = 8, and x = 0 about the y-axis.",
  "finalAnswer": "V = \\frac{96\\pi}{5}",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Express Radius as a Function of y",
      "mathExpression": "y = x^3 \\implies R(y) = x = y^{1/3}, \\quad 0 \\le y \\le 8",
      "explanation": "Solve for x in terms of y.",
      "why": "Horizontal slices perpendicular to y-axis."
    },
    {
      "stepNumber": 2,
      "title": "Set Up Volume Integral in y",
      "mathExpression": "V = \\pi \\int_0^8 [R(y)]^2 dy = \\pi \\int_0^8 (y^{1/3})^2 dy = \\pi \\int_0^8 y^{2/3} dy",
      "explanation": "Square the radius y^(1/3).",
      "why": "Disk method with dy slices."
    },
    {
      "stepNumber": 3,
      "title": "Evaluate Definite Integral",
      "mathExpression": "\\pi \\left[ \\frac{3}{5} y^{5/3} \\right]_0^8 = \\frac{3\\pi}{5} (8^{5/3}) = \\frac{3\\pi}{5} (32) = \\frac{96\\pi}{5}",
      "explanation": "8^(5/3) = (2)^5 = 32.",
      "why": "Exact numerical volume."
    }
  ],
  "sympyVerification": {
