  "author": "Muhammad Abdullah Athar",
  "problemStatement": "Find the volume of the solid generated by revolving the region under y = sqrt(x) on [0, 4] about the x-axis.",
  "finalAnswer": "V = 8\\pi",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Identify Radius Function",
      "mathExpression": "R(x) = \\sqrt{x}, \\quad r(x) = 0",
      "explanation": "The region borders the axis of revolution x-axis directly.",
      "why": "Disk method formulation."
    },
    {
      "stepNumber": 2,
      "title": "Set Up Volume Integral",
      "mathExpression": "V = \\pi \\int_0^4 [R(x)]^2 dx = \\pi \\int_0^4 (\\sqrt{x})^2 dx = \\pi \\int_0^4 x \\, dx",
      "explanation": "Square the radius and factor out pi.",
      "why": "Circular disk cross-section area."
    },
    {
      "stepNumber": 3,
      "title": "Evaluate Definite Integral",
      "mathExpression": "\\pi \\left[ \\frac{x^2}{2} \\right]_0^4 = \\pi \\left( \\frac{16}{2} \\right) = 8\\pi",
      "explanation": "Evaluate antiderivative at limits.",
      "why": "Final exact volume."
    }
  ],
