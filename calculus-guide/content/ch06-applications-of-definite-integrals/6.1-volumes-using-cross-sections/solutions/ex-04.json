  "author": "Muhammad Abdullah Athar",
  "problemStatement": "Find the volume generated by revolving the region bounded by y = sqrt(x) and y = x about the horizontal line y = 1.",
  "finalAnswer": "V = \\frac{\\pi}{6}",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Determine Radii from the Line y = 1",
      "mathExpression": "R(x) = 1 - x, \\quad r(x) = 1 - \\sqrt{x} \\quad \\text{on } [0, 1]",
      "explanation": "Distance from axis of revolution y = 1 to lower curve y = x is larger than distance to y = sqrt(x).",
      "why": "Radii measured from rotation axis."
    },
    {
      "stepNumber": 2,
      "title": "Formulate Difference of Squares",
      "mathExpression": "R(x)^2 - r(x)^2 = (1 - x)^2 - (1 - \\sqrt{x})^2 = (1 - 2x + x^2) - (1 - 2\\sqrt{x} + x) = 2x^{1/2} - 3x + x^2",
      "explanation": "Expand squared binomials and simplify.",
      "why": "Washer integrand simplification."
    },
    {
      "stepNumber": 3,
      "title": "Integrate over [0, 1]",
      "mathExpression": "V = \\pi \\int_0^1 (2x^{1/2} - 3x + x^2) dx = \\pi \\left[ \\frac{4}{3}x^{3/2} - \\frac{3}{2}x^2 + \\frac{x^3}{3} \\right]_0^1 = \\pi \\left( \\frac{4}{3} - \\frac{3}{2} + \\frac{1}{3} \\right) = \\pi \\left( \\frac{5}{3} - \\frac{3}{2} \\right) = \\frac{\\pi}{6}",
      "explanation": "Evaluate at limits 0 and 1.",
      "why": "Final exact volume."
    }
  ],
  "sympyVerification": {
