  "author": "Muhammad Abdullah Athar",
  "problemStatement": "Find the volume of the solid generated by revolving the region enclosed by y = x and y = x^2 about the x-axis.",
  "finalAnswer": "V = \\frac{2\\pi}{15}",
  "steps": [
    {
      "stepNumber": 1,
      "title": "Find Intersection Boundaries",
      "mathExpression": "x = x^2 \\implies x(1 - x) = 0 \\implies x = 0, \\; x = 1",
      "explanation": "The curves intersect at (0, 0) and (1, 1).",
      "why": "Integration limits on x-axis."
    },
    {
      "stepNumber": 2,
      "title": "Identify Outer and Inner Radii",
      "mathExpression": "R(x) = x, \\quad r(x) = x^2 \\quad \\text{for } x \\in [0, 1]",
      "explanation": "The line y = x is farther from the x-axis than the parabola y = x^2.",
      "why": "Determining outer and inner radii for washers."
    },
    {
      "stepNumber": 3,
      "title": "Integrate Difference of Squared Radii",
      "mathExpression": "V = \\pi \\int_0^1 (x^2 - x^4) dx = \\pi \\left[ \\frac{x^3}{3} - \\frac{x^5}{5} \\right]_0^1 = \\pi \\left( \\frac{1}{3} - \\frac{1}{5} \\right) = \\frac{2\\pi}{15}",
      "explanation": "Compute the definite integral.",
      "why": "Washer method volume formula."
    }
  ],
