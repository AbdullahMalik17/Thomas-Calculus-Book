      "stepNumber": 2,
      "title": "Evaluate in u-Variable",
      "mathExpression": "\\int_0^1 u \\, du = \\left[ \\frac{u^2}{2} \\right]_0^1 = \\frac{1}{2} - 0 = \\frac{1}{2}",
      "explanation": "Simple power integration.",
      "why": "Transformed definite integral evaluation."
    }
