      "stepNumber": 1,
      "title": "Choose Substitution and Compute Limits",
      "mathExpression": "u = \\tan(x) \\implies du = \\sec^2(x) dx; \\quad x = 0 \\implies u = \\tan(0) = 0, \\; x = \\pi/4 \\implies u = \\tan(\\pi/4) = 1",
