      "stepNumber": 2,
      "title": "Write Linearization Formula",
      "mathExpression": "L(x) = \\frac{1}{2} - \\frac{\\sqrt{3}}{2}\\left(x - \\frac{\\pi}{3}\\right)",
      "explanation": "Apply L(x) = f(a) + f'(a)(x - a).",
      "why": "Tangent approximation."
    }
