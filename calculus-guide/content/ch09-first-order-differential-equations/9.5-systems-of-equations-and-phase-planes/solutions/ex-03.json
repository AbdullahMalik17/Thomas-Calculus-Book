      "stepNumber": 2,
      "title": "Compute Characteristic Polynomial",
      "mathExpression": "\\det(A - \\lambda I) = (1 - \\lambda)^2 - 4 = \\lambda^2 - 2\\lambda - 3 = (\\lambda - 3)(\\lambda + 1) = 0",
      "explanation": "Set determinant equal to zero.",
      "why": "Eigenvalue equation."
    },
