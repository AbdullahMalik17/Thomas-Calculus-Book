  "title": "Tangent Substitution for sqrt(a^2 + x^2)",
  "exerciseReference": "Section 8.4, Exercise 2",
  "originalTopic": "Tangent Substitution",
  "difficulty": "tier2",
  "status": "verified",
  "tags": [
    "tangent-substitution",
