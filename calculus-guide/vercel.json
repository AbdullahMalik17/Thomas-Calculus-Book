{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "verify",
          "format": "url",
          "env": "VERIFY_URL"
        }
      ]
    },
    "verify": {
      "root": "tools/verify",
      "runtime": "python",
      "entrypoint": "server:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
